<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/pantry_item_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGuideRecipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Creamy Chicken Pasta"
        android:textColor="#1F2937"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGuideIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="• Chicken - 200 g"
        android:textColor="#4B5563"
        android:textSize="15sp"
        android:lineSpacingExtra="5dp" />

    <Button
        android:id="@+id/btnGuideViewRecipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="View Recipe"
        android:textAllCaps="false" />

</LinearLayout>