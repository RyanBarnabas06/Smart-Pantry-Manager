<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/pantry_item_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Recipe name -->
    <TextView
        android:id="@+id/tvRecipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chicken Pasta"
        android:textColor="#1F2937"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Recipe description -->
    <TextView
        android:id="@+id/tvRecipeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="A simple pasta recipe using ingredients from your pantry."
        android:textColor="#6B7280"
        android:textSize="14sp" />

    <!-- View recipe button -->
    <Button
        android:id="@+id/btnViewRecipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="View Recipe"
        android:textAllCaps="false" />

</LinearLayout>