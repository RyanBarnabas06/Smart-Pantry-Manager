<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical"
    tools:context=".RecipeDetailActivity">

    <!-- Dark background for the status bar area -->
    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#252525" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp">

        <!-- Recipe title -->
        <TextView
            android:id="@+id/tvRecipeDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textColor="#1F2937"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Recipe description -->
        <TextView
            android:id="@+id/tvRecipeDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Recipe description"
            android:textColor="#6B7280"
            android:textSize="16sp" />

        <!-- Ingredients heading -->
        <TextView
            android:id="@+id/tvIngredientsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Required Ingredients"
            android:textColor="#1F2937"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Ingredients list -->
        <TextView
            android:id="@+id/tvRecipeDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ingredients"
            android:textColor="#4B5563"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

    <!-- Back button -->
    <Button
        android:id="@+id/btnBackToRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="60dp"
        android:text="Back to Recipes"
        android:textAllCaps="false"
        android:textSize="16sp" />

</LinearLayout>